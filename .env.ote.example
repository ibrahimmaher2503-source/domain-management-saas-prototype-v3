APP_ENV=ote
APP_DEBUG=false
APP_URL=http://127.0.0.1:8002

# Use an isolated database. The value must end with _ote.
DB_CONNECTION=pgsql
DB_DATABASE=domain_management_ote

# Use Redis namespaces/databases that are not shared with production.
REDIS_PREFIX=domain-saas-ote-
REDIS_DB=10
REDIS_CACHE_DB=11
CACHE_PREFIX=domain-saas-ote-cache-
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

ONLINENIC_HOST=ote.onlinenic.com
ONLINENIC_PORT=30009
ONLINENIC_CLIENT_ID=
ONLINENIC_PASSWORD=
ONLINENIC_REGISTRANT_CONTACT_ID=
ONLINENIC_ADMIN_CONTACT_ID=
ONLINENIC_TECH_CONTACT_ID=
ONLINENIC_BILLING_CONTACT_ID=
ONLINENIC_ACCOUNT_CURRENCY=

ONLINENIC_OTE_ALLOW_WRITES=false
ONLINENIC_OTE_CONFIRM=
ONLINENIC_OTE_TEST_DOMAIN=
ONLINENIC_OTE_TEST_DOMAIN_PASSWORD=
ONLINENIC_OTE_TEST_NAMESERVER_1=
ONLINENIC_OTE_TEST_NAMESERVER_2=
