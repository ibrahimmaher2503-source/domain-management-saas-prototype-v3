APP_NAME="Domain Management SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=domain_management
DB_USERNAME=domain_management
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE_RETRY_AFTER=180

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

TRUSTED_PROXIES=127.0.0.1
FILESYSTEM_DISK=local

ONLINENIC_HOST=www.onlinenic.com
ONLINENIC_PORT=30009
ONLINENIC_CLIENT_ID=
ONLINENIC_PASSWORD=
ONLINENIC_REGISTRANT_CONTACT_ID=
ONLINENIC_ADMIN_CONTACT_ID=
ONLINENIC_TECH_CONTACT_ID=
ONLINENIC_BILLING_CONTACT_ID=
ONLINENIC_CONNECT_TIMEOUT=10
ONLINENIC_READ_TIMEOUT=30
ONLINENIC_ACCOUNT_CURRENCY=
CUSTOMER_BILLING_CURRENCY=
DOMAIN_REGISTRATION_MARKUP_PERCENT=20

PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_MODE=live
PAYMOB_PAYMENT_EXPIRATION=3600
PAYMOB_CALLBACK_MAX_BYTES=65536
PAYMOB_NOTIFICATION_URL=https://example.com/payments/paymob/callback
PAYMOB_REDIRECTION_URL=https://example.com/payments/paymob/return

CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

SSL_DV_ENABLED=false
SSL_DV_PRODUCT_CODE=RapidSSL
SSL_DV_CUSTOMER_PRICE=
SSL_DV_CURRENCY=
SSL_WEB_SERVER_TYPE=apacheopenssl
